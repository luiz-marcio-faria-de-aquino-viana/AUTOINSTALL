1000 ' LMV - DEZ/90 - CATALOGO DE PROJETORES
1010 DIM GX(20),GY(20),IX(20),IY(20)
1020 CLS:KEY OFF
1030 PRINT"AQ - projetos de instalacoes ltda.";TAB(75)"DEZ/90"
1040 COLOR 15,1:LOCATE 7,26:PRINT CHR$(214);STRING$(28,196);CHR$(183)
1050 FOR Y=8 TO 14:LOCATE Y,26:PRINT CHR$(186);SPC(28);CHR$(186):NEXT Y
1060 LOCATE 15,26:PRINT CHR$(211);STRING$(28,196);CHR$(189)
1070 COLOR 7,1:LOCATE 10,35:PRINT"CATALOGO DE":LOCATE 12,36:PRINT"PROJETORES"
1080 COLOR 15,0:LOCATE 25,66:PRINT"Tecle [ BARRA ]";:COLOR 7,0
1090 C$=INKEY$:IF C$<>" " THEN 1090
1100 CLS:PRINT"ENTRADA DE DADOS:":PRINT STRING$(17,223)
1110 LOCATE 5,1
1120 PRINT TAB(10)"- FABRICANTE: ";:LINE INPUT F$
1125 IF F$="" THEN RUN"LUMENS"
1130 IF LEN(F$)>15 THEN 1120
1140 F$=F$+STRING$(15-LEN(F$),32)+"^"
1150 PRINT TAB(10)"- MODELO: ";:LINE INPUT M$
1160 IF LEN(M$)>15 THEN 1150
1170 M$=M$+STRING$(15-LEN(M$),32)+"^"
1180 PRINT TAB(10)"- LAMPADA(S): ";:LINE INPUT L$
1190 IF LEN(L$)>40 THEN 1180
1200 L$=L$+STRING$(40-LEN(L$),32)+"^"
1210 PRINT:PRINT TAB(18)"(EIXO CD)"
1220 PRINT:PRINT TAB(12)"ANGULO     ILUMINANCIA":PRINT TAB(13)"(";CHR$(248);")";TAB(26)"(Lm)":PRINT
1230 I=1:WHILE I<21
1240 PRINT TAB(5)USING"##";I;:PRINT TAB(12)"";:INPUT GX$
1250 IF GX$="" THEN 1290 ELSE GX(I)=VAL(GX$)
1260 LOCATE CSRLIN-1,24:INPUT IX(I)
1270 I=I+1
1280 WEND
1290 FOR Y=I TO 20:GX(Y)=0:IX(Y)=0:NEXT Y
1300 PRINT:PRINT TAB(10)"- CURVA COM DISTRIBUICAO SIMETRICA (S/N)? ";CHR$(177)
1310 C$=INKEY$:IF C$="S" THEN LOCATE CSRLIN-1,52:PRINT C$:FOR I=1 TO 20:IY(I)=IX(I):GY(I)=GX(I):NEXT I:GOTO 1400 ELSE IF C$<>"N" THEN 1310
1320 LOCATE CSRLIN-1,52:PRINT C$:PRINT:PRINT TAB(18)"(EIXO AB)"
1325 PRINT:PRINT TAB(12)"ANGULO     ILUMINANCIA":PRINT TAB(13)"(";CHR$(248);")";TAB(26)"(Lm)":PRINT
1330 I=1:WHILE I<21
1340 PRINT TAB(5)USING"##";I;:PRINT TAB(12)"";:INPUT GY$
1350 IF GY$="" THEN 1390 ELSE GY(I)=VAL(GY$)
1360 LOCATE CSRLIN-1,24:INPUT IY(I)
1370 I=I+1
1380 WEND
1390 FOR Y=I TO 20:GY(Y)=0:IY(Y)=0:NEXT Y
1400 CLS:LOCATE 12,35:PRINT"ARQUIVANDO":LOCATE 13,35:PRINT STRING$(10,223)
1410 OPEN"R",#1,"PRJTRS",128
1415 RG=LOF(1)/128+1
1420 PRINT #1,F$;M$;L$
1430 PUT #1,RG
1440 CLOSE #1
1450 OPEN"R",#1,"IXPRJTRS",64
1455 RG=LOF(1)/64+1
1460 FOR I=1 TO 20:PRINT #1,M$;USING"##.##";GX(I);:PRINT #1,"^";USING"#####.##";IX(I);:PRINT #1,"^":PUT #1,RG+I-1:NEXT I:CLOSE #1
1470 OPEN"R",#1,"IYPRJTRS",64
1475 RG=LOF(1)/64+1
1480 FOR I=1 TO 20:PRINT #1,M$;USING"##.##";GY(I);:PRINT #1,"^";USING"#####.##";IY(I);:PRINT #1,"^":PUT #1,RG+I-1:NEXT I:CLOSE #1
1490 GOTO 1100
R