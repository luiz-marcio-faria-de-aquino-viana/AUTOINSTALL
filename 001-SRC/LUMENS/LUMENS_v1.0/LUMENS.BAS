2260 ' LMV - RECUPERANDO DADOS
2270 OPEN"R",#1,"IXPRJTRS",64
2280 OPEN"R",#2,"IYPRJTRS",64
2290 RG=(CD-1)*20
2300 FOR X=1 TO 20
2310 GET #1,RG+X:INPUT #1,C$
2320 GX(X)=(VAL(MID$(C$,17,5))/180)*3.141592:IX(X)=VAL(MID$(C$,23,8))
2330 GET #2,RG+X:INPUT #2,C$
2340 GY(X)=(VAL(MID$(C$,17,5))/180)*3.141592:IY(X)=VAL(MID$(C$,23,8))
2350 NEXT X
2360 CLOSE #1,#2
2370 ' LMV - DELIMITANDO AREA DE CALCULO
2380 X0=VX(1):Y0=VY(1):XM=X0:YM=Y0
2390 FOR X=1 TO VT
2400 IF X0>VX(X) THEN X0=VX(X)
2410 IF Y0>VY(X) THEN Y0=VY(X)
2420 IF XM<VX(X) THEN XM=VX(X)
2430 IF YM<VY(X) THEN YM=VY(X)
2440 NEXT X
2450 ' LMV - CALCULANDO STEP
2460 D1=(XM-X0)/19:N=INT((YM-Y0)/D1):D2=(YM-Y0)/N
2470 ' LMV - CALCULOS
2480 Y=N:WHILE Y>=1
2490 YP=Y0+D2/2+(Y-1)*D2
2500 LOCATE N+3-Y,2
2510 X=1:WHILE X<=19
2520 XP=X0+D1/2+(X-1)*D1
2530 IF F1=2 THEN ET=ET(X,Y):GOTO 2550
2540 ET=0:FOR K=1 TO NR
2550 LP=SQR((XP-RX(K))^2+(YP-RY(K))^2+RZ(K)^2)
2560 LF=SQR((FX(K)-RX(K))^2+(FY(K)-RY(K))^2+RZ(K)^2)
2570 CT=((XP-RX(K))*(FX(K)-RX(K))+(YP-RY(K))*(FY(K)-RY(K))+RZ(K)^2)/(LP*LF)
2580 IF CT>=1 THEN CT=1
2590 IF CT=0 THEN TE=1.570796:GOTO 2610
2600 TE=ATN(SQR((1/CT^2)-1))
2610 HP=SQR((XP-RX(K))^2+(YP-RY(K))^2)
2620 HF=SQR((FX(K)-RX(K))^2+(FY(K)-RY(K))^2)
2630 IF HP=0 OR HF=0 THEN CG=1:GOTO 2660
2640 CG=((XP-RX(K))*(FX(K)-RX(K))+(YP-RY(K))*(FY(K)-RY(K)))/(HP*HF)
2650 IF CG>=1 THEN CG=1
2660 IF CG=0 THEN GA=1.570796:GOTO 2690
2670 GA=ATN(SQR((1/CG^2)-1))
2680 IF CT=1 THEN CA=1:GOTO 2700
2690 A=HP*SQR(1-CG^2):CA=A/(LP*SQR(1-CT^2)):IF CA>=1 THEN CA=1
2700 IF CA=0 THEN AL=1.57 ELSE AL=ATN(SQR((1/CA^2)-1))
2710 ' LMV - ANALISE ANGULAR
2720 W=0:U=0
2730 FOR T=2 TO 20
2740 IF TE<GX(T) AND U=0 THEN T1=T:U=1
2750 IF TE<GY(T) AND W=0 THEN T2=T:W=1
2760 NEXT T
2770 IF U=0 THEN IX=0:GOTO 2790
2780 IX=IX(T1-1)+((TE-GX(T1-1))/(GX(T1)-GX(T1-1)))*(IX(T1)-IX(T1-1))
2790 IF W=0 THEN IY=0:GOTO 2810
2800 IY=IY(T2-1)+((TE-GY(T2-1))/(GY(T2)-GY(T2-1)))*(IY(T2)-IY(T2-1))
2810 I=IX+AL/90*(IY-IX)
2820 IP=I*FL*(FT/100)/1000
2830 E=IP*RZ(K)/LP^3:FR%(K,X,Y)=E*10:IF LG%(K)=0 THEN 2850
