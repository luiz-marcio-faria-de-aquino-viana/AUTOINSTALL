1000 ' LMV - DEZ/90 - IMPRESSAO DO CALCULO DAS LUMINARIAS
1010 DIM VX(20),VY(20),RX(50),RY(50),RZ(50),FX(50),FY(50),ET(19,19),FR%(50,19,19),LG%(50)
1020 CLS:KEY OFF
1030 PRINT"AQ - projetos de instalacoes ltda.";TAB(75)"DEZ/90"
1040 COLOR 15,2:LOCATE 9,26:PRINT CHR$(201);STRING$(27,205);CHR$(187)
1050 FOR Y=10 TO 14:LOCATE Y,26:PRINT CHR$(186);STRING$(27,32);CHR$(186):NEXT Y
1060 LOCATE Y,26:PRINT CHR$(200);STRING$(27,205);CHR$(188)
1070 COLOR 7,2:LOCATE 11,31:PRINT"IMPRESSAO DO CALCULO":LOCATE 13,34:PRINT"DE ILUMINAMENTO"
1080 COLOR 15,0:LOCATE 25,66:PRINT"Tecle [ BARRA ]";:COLOR 7,0
1090 C$=INKEY$:IF C$<>" " THEN 1090
1095 GOSUB 4000
1100 CLS
1110 LOCATE 12,32:PRINT"RECUPERANDO DADOS":LOCATE 13,32:PRINT STRING$(17,223)
1120 OPEN"I",#1,NM$+".IMP"
1130 INPUT #1,CD,FL,IM,FT,VT
1140 FOR I=1 TO 20:INPUT #1,VX(I),VY(I):NEXT I
1150 INPUT #1,NR
1160 FOR I=1 TO 50:INPUT #1,RX(I),RY(I),RZ(I),FX(I),FY(I):NEXT I
1170 INPUT #1,NY
1180 FOR Y=1 TO 19:FOR X=1 TO 19:INPUT #1,ET(X,Y):NEXT X,Y
1187 FOR K=1 TO 50:INPUT #1,LG%(K):NEXT K
1190 CLOSE #1
1200 OPEN"R",#1,"PRJTRS"
1210 GET #1,CD
1220 INPUT #1,A$:FB$=MID$(A$,1,15):MD$=MID$(A$,17,15):LP$=MID$(A$,33,40)
1230 CLOSE #1
1233 LG=0:FOR X=1 TO NR
1235 IF LG%(X)=-1 THEN LG=LG+1
1237 NEXT X
1240 CLS
1250 LOCATE 12,35:PRINT"IMPRIMINDO":LOCATE 13,35:PRINT STRING$(10,223)
1260 LPRINT TAB(5)CHR$(14);"AQ";CHR$(20);" - projetos de instalacoes ltda."
1270 NL%=5:GOSUB 3000:LPRINT TAB(10)"- MODELO DO REFLETOR:"
1280 NL%=1:GOSUB 3000:LPRINT TAB(20)CHR$(27);"G";FB$+MD$;CHR$(27);"H"
1290 NL%=2:GOSUB 3000:LPRINT TAB(10)"- LAMPADA(S) UTILIZADA(S):"
1300 NL%=1:GOSUB 3000:LPRINT TAB(20)LP$
1305 NL%=3:GOSUB 3000:LPRINT TAB(10)"- NUMERO DE REFLETORES =";TAB(53)USING"##";LG
1310 NL%=1:GOSUB 3000:LPRINT TAB(10)"- FLUXO LUMINOSO POR REFLETOR =";TAB(49)USING"######";FL;:LPRINT" Lm"
1320 NL%=1:GOSUB 3000:LPRINT TAB(10)"- FLUXO LUMINOSO TOTAL =";TAB(47)USING"########";FL*LG;:LPRINT" Lm"
1330 NL%=1:GOSUB 3000:LPRINT TAB(10)"- INDICE MEDIO DESEJADO =";TAB(51)USING"####";IM;:LPRINT" LUX"
1340 NL%=1:GOSUB 3000:LPRINT TAB(10)"- FATOR DE DEPRECIACAO =";TAB(52)USING"###";FT;:LPRINT" %"
1350 NL%=3:GOSUB 3000:LPRINT TAB(10)"- COORDENADA DOS VERTICES DA AREA A SER ILUMINADA:"
1360 NL%=1:GOSUB 3000:LPRINT TAB(15)"VERTICE       ABSCISA X      ORDENADA Y":LPRINT TAB(31)"(m)";TAB(47)"(m)"
1370 NL%=1:GOSUB 3000:X0=VX(1):Y0=VY(1):XM=X0:YM=Y0
1380 FOR I=1 TO VT:LPRINT TAB(17)USING"###";I;:LPRINT TAB(28)USING"####.##";VX(I);:LPRINT TAB(44)USING"####.##";VY(I)
1390 IF VX(I)<X0 THEN X0=VX(I)
1400 IF VX(I)>XM THEN XM=VX(I)
1410 IF VY(I)<Y0 THEN Y0=VY(I)
1420 IF VY(I)>YM THEN YM=VY(I)
1430 NEXT I
1440 NL%=2:GOSUB 3000:LPRINT TAB(10)"- COORDENADA DOS VERTICES DA AREA DE CALCULO:"
1450 NL%=1:GOSUB 3000:LPRINT TAB(15)"VERTICE       ABSCISA X      ORDENADA Y":LPRINT TAB(31)"(m)";TAB(47)"(m)"
1460 NL%=1:GOSUB 3000:LPRINT TAB(19);"1";:LPRINT TAB(28)USING"####.##";X0;:LPRINT TAB(44)USING"####.##";Y0
1470 LPRINT TAB(19);"2";:LPRINT TAB(28)USING"####.##";XM;:LPRINT TAB(44)USING"####.##";Y0
1480 LPRINT TAB(19);"3";:LPRINT TAB(28)USING"####.##";XM;:LPRINT TAB(44)USING"####.##";YM
1490 LPRINT TAB(19);"4";:LPRINT TAB(28)USING"####.##";X0;:LPRINT TAB(44)USING"####.##";YM
1500 LPRINT CHR$(12)
1510 LPRINT TAB(5)CHR$(14);"AQ";CHR$(20);" - projetos de instalacoes ltda."
1520 NL%=5:GOSUB 3000:LPRINT TAB(10)"- LOCALIZACAO DOS REFLETORES E DOS RESPECTIVOS FOCOS:"
1530 NL%=1:GOSUB 3000:LPRINT TAB(16)"REFLETOR(ES)";TAB(54)"FOCO(S)"
1540 LPRINT TAB(7)"ABSCISA X    ORDENADA Y    COTA Z       ABSCISA X    ORDENADA Y"
1550 LPRINT TAB(9)"(m)";TAB(23)"(m)";TAB(35)"(m)";TAB(49);"(m)";TAB(63)"(m)":NL%=1:GOSUB 3000
1560 FOR I=1 TO NR
1565 IF LG%(I)=0 THEN 1620
1570 LPRINT"  ";USING"##";I;:LPRINT TAB(6)USING"####.##";RX(I);
1580 LPRINT TAB(20)USING"####.##";RY(I);
1590 LPRINT TAB(32)USING"####.##";RZ(I);
1600 LPRINT TAB(46)USING"####.##";FX(I);
1610 LPRINT TAB(60)USING"####.##";FY(I)
1620 NEXT I
1625 NL%=3:GOSUB 3000:LPRINT TAB(36)"********"
1630 IF NR>30 THEN LPRINT CHR$(12):LPRINT TAB(5)CHR$(14);"AQ";CHR$(20)" - projetos de instalacoes ltda."
1635 NL%=3:GOSUB 3000:ET=0
1640 FOR Y=NY TO 1 STEP -1:LPRINT:FOR X=1 TO 19
1650 LPRINT USING"####";ET(X,Y);
1660 ET=ET+ET(X,Y)
1670 NEXT X,Y
1680 NL%=4:GOSUB 3000
1685 LPRINT TAB(10)"- INDICE MEDIO DE ILUMINAMENTO =";TAB(45)USING"####.##";ET/(20*NY)
1690 LPRINT CHR$(12);
1700 GOTO 1095
3000 ' LMV - PULANDO LINHAS
3010 FOR I=1 TO NL%:LPRINT"":NEXT I
3020 RETURN
4000 ' LMV - ENTRADA DE DADOS
4010 CLS:PRINT"ENTRADA DE DADOS:":PRINT STRING$(17,223)
4020 LOCATE 5,1
4025 PRINT TAB(10)"- ARQUIVOS DISPONIVEIS:":PRINT:FILES"*.IMP"
4030 PRINT:PRINT TAB(10)"- NOME DO ARQUIVO DE IMPRESSAO: ";:INPUT NM$
4035 IF NM$="" THEN RUN"LUMENS"
4040 IF LEN(NM$)>8 THEN 4030
4050 RETURN
