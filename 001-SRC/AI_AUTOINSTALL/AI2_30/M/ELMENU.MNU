***Buttons
$s=osnap
;
***pop1
Setup
[Load SETup]^c^c^p$p1=* (progn (initget "Yes No")+
(if (/= (getkword "Executar SETup (Yes/No)? ") "No")+
(progn (prompt "^JCarregando... ")(loadf "k1bc0")(c:setup)))(princ))
Yes
No
[~--]
[Reset Layers]^C^CSCRIPT LAYER
[Reset Vars]^C^CSCRIPT SETVAR
[~--]
[Regiao de Trabalho (AutoDWG)]^C^CAD_INSERT
[Etapa do Projeto (AutoPLOT) ]^C^CAP_ETPPROJ

