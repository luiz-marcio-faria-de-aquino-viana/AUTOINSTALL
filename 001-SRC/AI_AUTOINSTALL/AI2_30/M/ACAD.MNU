(menucmd "S=X")(menucmd "S=P0"))(progn(terpri)+
(princ "Entity selected is not a polyline.")(terpri)(setq m:s1 nil))))))))+
(defun m:p1 (/ m:a)(menucmd"S=X")(if(=(setq m:a (cdr(assoc 70 m:e2)))nil);+
