[Freeze Inst]^c^clayer s 0 f arq-* f el-* f es-* f h-* f g-* f te-* f ti-* f ie-* f ar-* ;
[Thaw Inst]^c^clayer s 0 t arq-* t el-* t es-* t h-* t g-* t te-* t ti-* t ie-* t ar-* ;
[~--]
[Freeze All]^c^clayer s 0 f * t 0 ;
[Thaw All]^c^clayer s 0 t * ;

***pop8
[Menus]
[Arquitetura]^c^clayer t arq-*  menu ARQmenu
[Formas]^c^clayer t f-*  menu Fmenu
[ELetrica]^c^clayer t el-*  menu ELmenu
[ESgoto]^c^clayer t es-*  menu ESmenu
[Hidraulica]^c^clayer t h-*  menu Hmenu
[INCendio]^c^clayer t inc-*  menu INCmenu
[Gas]^c^clayer t g-*  menu Gmenu
[TExterno]^c^clayer t te-*  menu TEmenu
[TInterno]^c^clayer t ti-*  menu TImenu
[IEspecial]^c^clayer t ie-*  menu IEmenu
[AR condicionado]^c^clayer t ar-*  menu ARmenu
[~--]
[AutoCAD]^c^c^p$p8=* (progn+
(initget "Yes No")+
(if (/= (getkword "Executar menu do AutoCAD (Yes/No)? ") "No")+
(progn (prompt "^J--- Carregando menu ACAD... ---") (command "menu" "ACAD"))+
(princ)+
))
Yes
No

