[ELetrica Freeze/Thaw]^c^c^p(progn(if(null setlayer)(loadf"k1cc0"))(princ)) (SETlayer "EL-")
[ESgoto Freeze/Thaw]^c^c^p(progn(if(null setlayer)(loadf"k1cc0"))(princ)) (SETlayer "ES-")
[Hidraulica Freeze/Thaw]^c^c^p(progn(if(null setlayer)(loadf"k1cc0"))(princ)) (SETlayer "H-")
