***POP0
[Osnap]
[Layer Filter...          ]^p(aci_filter_layerfilter_cmd)
[--]
[Endpoint Snap            ]_endp
[Midpoint Snap            ]_mid
[Intersection Snap        ]_int
[Perpendicular Snap       ]_per
[Nearest Snap             ]_nea
[Center Snap              ]_center
[Quadrant Snap            ]_qua
[Tangent Snap             ]_tan
[Point Snap               ]_nod
[Insertion Snap           ]_ins
[--]
[Paralela]^p(paralela)
[45d]^p(45gr)
[--]
[Snap off All     ]_none
[Object snap...]'_ddosnap

