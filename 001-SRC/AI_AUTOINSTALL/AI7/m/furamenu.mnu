           [->&Offset    ]
ID_OffTh     [&Thought   ]^c^coffset t
ID_OffDist   [&Distance  ]^c^coffset
             [--]
             [    2.5 cm   ]^c^coffset ^p(/ 25.0 (#UND))
             [    5.0 cm   ]^c^coffset ^p(/ 50.0 (#UND))
             [ < 10.0 cm > ]^c^coffset ^p(/ 100.0 (#UND))
             [   15.0 cm   ]^c^coffset ^p(/ 150.0 (#UND))
             [   20.0 cm   ]^c^coffset ^p(/ 200.0 (#UND))
             [   25.0 cm   ]^c^coffset ^p(/ 250.0 (#UND))
             [   30.0 cm   ]^c^coffset ^p(/ 300.0 (#UND))
             [   50.0 cm   ]^c^coffset ^p(/ 500.0 (#UND))
             [  100.0 cm   ]^c^coffset ^p(/ 1000.0 (#UND))
             [  125.0 cm   ]^c^coffset ^p(/ 1250.0 (#UND))
             [  150.0 cm   ]^c^coffset ^p(/ 1500.0 (#UND))
             [  200.0 cm   ]^c^coffset ^p(/ 2000.0 (#UND))
             [  250.0 cm   ]^c^coffset ^p(/ 2500.0 (#UND))
             [  500.0 cm   ]^c^coffset ^p(/ 5000.0 (#UND))
             [  750.0 cm   ]^c^coffset ^p(/ 7500.0 (#UND))
             [<- 1000.0 cm ]^c^coffset ^p(/ 10000.0 (#UND))
           [->Offset change]
ID_OffTh     [&Thought   ]^c^coffset t
ID_OffDist   [&Distance  ]^c^coffset
             [--]
             [    2.5 cm   ]^c^c^p(setq #OFFDIST (/ 25.0 (#UND))) offchg ;
             [    5.0 cm   ]^c^c^p(setq #OFFDIST (/ 50.0 (#UND))) offchg ;
             [ < 10.0 cm > ]^c^c^p(setq #OFFDIST (/ 100.0 (#UND))) offchg ;
