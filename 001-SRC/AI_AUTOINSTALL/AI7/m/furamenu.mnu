(setvar "cmdecho" 0)
(Command "LWDISPLAY" "OFF")
(princ)


***MENUGROUP=AI_FURAMENU

***BUTTONS1
;
$p0=*

***BUTTONS2
$p0=*

***AUX1
;
$p0=*

***AUX2
$p0=*

***POP0
[Osnap]
[Layer Filter...          ]^p(aci_filter_layerfilter_cmd)
[--]
[Endpoint Snap            ]_endp
[Midpoint Snap            ]_mid
[Intersection Snap        ]_int
[Perpendicular Snap       ]_per
[Nearest Snap             ]_nea
[Center Snap              ]_center
[Quadrant Snap            ]_qua
[Tangent Snap             ]_tan
[Point Snap               ]_nod
[Insertion Snap           ]_ins
[--]
[Paralela]^p(paralela)
[45d]^p(45gr)
[--]
[Snap off All     ]_none
[Object snap...]'_ddosnap


***POP1
           [&File]
ID_New     [&New...\tCtrl+N  ]^C^C_new setup
           [--]
ID_Open    [&Open...\tCtrl+O ]^C^C_open
ID_Close   [&Close           ]^C^C^C_CLOSE
ID_Save    [&Save\tCtrl+S    ]^C^C_qsave
ID_Saveas  [S&ave As...      ]^C^C_saveas
           [--]
ID_Setup     [&Setup...]^c^cddsetup
             [--]
ID_Lay       [&Re-inicializacao Camadas  ]^c^credeflay
ID_Svar      [R&e-inicializacao Variaveis]^c^cscript setvar
             [--]
ID_Print   [&Imprimir...\tCtrl+P]^C^C^C_PRINT
           [--]
ID_QrCode  [&Insere QrCode...   ]^C^C^Cai_qrCodeGen
           [--]
ID_Recover [Recover             ]^C^C^C_RECOVER
ID_Audit   [Audit               ]^C^C^C_AUDIT y
ID_Puall   [Purge ALL           ]^C^C^C_PURGE;_all;;_ALL;
           [--]
ID_Exit    [E&xit               ]^C^C^C_EXIT


***POP2
           [&Edit]
ID_Undo    [&Undo\tCtrl+Z      ]^C^C^C_U
ID_Redo    [&Redo\tCtrl+Y      ]^C^C^C_REDO
           [--]
ID_Selall  [Select &All\tCtrl+A]^C^C^C_SELGRIPS;_ALL;
           [--]
ID_Cut     [Cu&t\tCtrl+X     ]^C^C^C_CUTCLIP
ID_Copy    [&Copy\tCtrl+C    ]^C^C^C_COPYCLIP
ID_Crop    [C&rop            ]^C^C^C_ERASE;_ALL;R
ID_Paste   [&Paste\tCtrl+V   ]^C^C^C_PASTECLIP
ID_Pastesp [Paste &Special...]^C^C^C_PASTESPEC
           [--] 
ID_Del     [&Delete	Del  ]^C^C^C_DELETE

***POP3
           [&Blocks]
ID_Carimbo [&Carimbo]^c^ccarimbo
           [--]
ID_Detlh   [&Detalhes Tipicos]^c^cddgdet
           [--]
ID_Isoblk  [Isome&trico  ]^c^cisoblk
ID_Blkdet  [Det&alhamento]^c^cdetblk
           [--]
