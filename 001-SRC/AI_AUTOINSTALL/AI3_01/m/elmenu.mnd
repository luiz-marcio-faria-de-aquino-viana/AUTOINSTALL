***POP0
[Osnap]
[*CANCEL*]^C^C^C
[--]
['Redraw]'REDRAW
[--]
[Endpoint             ]_endp
[Midpoint             ]_mid
[Intersection         ]_int
[Perpendicular        ]_per
[Nearest              ]_nea
[--]
[Center               ]_center
[Quadrant             ]_qua
[Tangent              ]_tan
[Node                 ]_nod
[Insertion            ]_ins
[None                 ]_non
[--]
[Paralela]^p(paralela)
[45d]^p(45gr)
[--]
[.X].X
[.Y].Y
[--]
[U   ]^C^C^CU
[Redo]^C^C^CREDO
[--]
[Object snap...]^C^CDDOSNAP

***POP1
           [&File]
